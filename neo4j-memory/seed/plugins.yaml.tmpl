# Template rendered with a values file before parsing, as Helm renders a chart
# with values.yaml. Values that depend on who loads it stay out of the repo.
owner: {{ .user | quote }}
scopes:
  - name: {{ .user | quote }}
    description: {{ printf "%s 사용자가 진행하는 세션" .user | quote }}
  - name: claude-workflow-kit 리포지토리
    description: nil-park/claude-workflow-kit 리포지토리에서 작업하는 세션
  - name: GitHub 리포지토리
    description: 원격 저장소가 GitHub에 있는 리포지토리에서 작업하는 세션
  - name: GitLab 리포지토리
    description: 원격 저장소가 GitLab에 있는 리포지토리에서 작업하는 세션
  - name: 파일 작성
    description: 코드, 문서, 설정 등 파일을 만들거나 고치는 작업. 읽기만 하는 조사나 파일을 남기지 않는 운영 작업은 해당하지 않는다.
  - name: 코드 작성
    description: 코드를 한 줄이라도 쓰거나 고치는 작업과 코드 리뷰
  - name: 문서 작성
    description: 프로젝트 문서, 이슈와 PR/MR의 제목과 본문, 코드 주석을 쓰거나 고치는 작업
  - name: 한국어 문체 교정
    description: 사용자가 "anti-claudeism", "안티클로디즘", "클로디즘"이라고 말하며 한국어 텍스트의 Claude 문체를 걷어내라고 요청하는 작업
  - name: 브랜치와 PR 작업
    description: 브랜치를 만들거나 PR/MR을 열고 고치는 작업. "PR 작성하자", "MR 이어서 작업하자" 같은 요청
  - name: 작업 파일 저장
    description: 커밋하지 않는 작업 파일을 어디에 저장할지 정하거나, 여러 줄 텍스트를 CLI 플래그나 stdin으로 넘기는 작업
  - name: 듀오 세션
    description: Claude Code 세션이 지시하고 리뷰하며, agy 세션(peer)이 리포지토리 파일을 편집하는 2인 작업
    disableModelInvocation: true
  - name: 듀오 세션 peer
    description: 듀오 세션에서 Claude Code 세션의 지시를 받아 리포지토리 파일을 편집하는 agy 세션
  - name: 멀티 세션
    description: 이 세션이 오케스트레이터가 되어 여러 peer 세션에 설계, 구현, 한국어 검수를 나눠 맡기는 작업
    disableModelInvocation: true
  - name: "peer CLI: Antigravity CLI"
    description: 멀티 세션의 peer로 Antigravity CLI(agy)를 쓰는 세션
  - name: "peer CLI: Claude Code"
    description: 멀티 세션의 peer로 Claude Code를 쓰는 세션
  - name: "peer CLI: Codex CLI"
    description: 멀티 세션의 peer로 Codex CLI를 쓰는 세션
  - name: "peer CLI: GitHub Copilot CLI"
    description: 멀티 세션의 peer로 GitHub Copilot CLI를 쓰는 세션
  - name: "peer CLI: Gemini CLI"
    description: 멀티 세션의 peer로 Gemini CLI를 쓰는 세션

instructions:
  - key: work-cycle
    title: 작성-리뷰 사이클
    file: plugins/project-skills-bootstrap/skills/bootstrap-work-cycle/work-cycle.md
    scopes: [{{ .user | quote }}, 파일 작성]
  - key: coding-standards
    title: 코드 작성과 리뷰 기준
    file: plugins/project-skills-bootstrap/skills/bootstrap-coding-standards/coding-standards.md
    scopes: [{{ .user | quote }}, 코드 작성]
  - key: docs-standards
    title: 문서 배치와 작성 기준
    file: plugins/project-skills-bootstrap/skills/bootstrap-docs-standards/docs-standards.md
    scopes: [{{ .user | quote }}, 문서 작성]
  - key: anti-claudeism
    title: Claude 문체 걷어내기
    file: plugins/project-skills-bootstrap/skills/bootstrap-anti-claudeism/anti-claudeism.md
    scopes: [{{ .user | quote }}, 한국어 문체 교정]
  - key: git-workflow@github
    title: GitHub 브랜치와 PR 절차
    file: plugins/project-skills-bootstrap/skills/bootstrap-git-workflow/git-workflow-github.md
    scopes: [{{ .user | quote }}, 브랜치와 PR 작업, GitHub 리포지토리]
  - key: git-workflow@gitlab
    title: GitLab 브랜치와 MR 절차
    file: plugins/project-skills-bootstrap/skills/bootstrap-git-workflow/git-workflow-gitlab.md
    scopes: [{{ .user | quote }}, 브랜치와 PR 작업, GitLab 리포지토리]
  - key: scratch-dir
    title: 작업 파일 저장 위치
    file: plugins/project-skills-bootstrap/skills/bootstrap-scratch-dir/scratch-dir.md
    scopes: [{{ .user | quote }}, 작업 파일 저장]
  - key: duo-session
    title: 듀오 세션 main 지침
    file: plugins/project-skills-bootstrap/skills/bootstrap-duo-session/duo-session.md
    scopes: [{{ .user | quote }}, 듀오 세션]
  - key: duo-session-peer
    title: 듀오 세션 peer 지침
    file: plugins/project-skills-bootstrap/skills/bootstrap-duo-session/duo-session-peer.md
    scopes: [{{ .user | quote }}, 듀오 세션 peer]
  - key: multi-session
    title: 멀티 세션 오케스트레이터 지침
    file: plugins/project-skills-bootstrap/skills/bootstrap-multi-session/multi-session.md
    scopes: [{{ .user | quote }}, 멀티 세션]

variants:
  - key: scratch-dir@claude-workflow-kit
    title: 작업 파일 저장 위치 / claude-workflow-kit 리포지토리
    slots:
      scratch_dir: .refs
    includedBy: scratch-dir
    scopes: [{{ .user | quote }}, 작업 파일 저장, claude-workflow-kit 리포지토리]
  - key: multi-session@agy
    title: 멀티 세션 / Antigravity CLI peer
    file: plugins/project-skills-bootstrap/skills/bootstrap-multi-session/variants/agy.md
    includedBy: multi-session
    scopes: [{{ .user | quote }}, 멀티 세션, "peer CLI: Antigravity CLI"]
  - key: multi-session@claude-code
    title: 멀티 세션 / Claude Code peer
    file: plugins/project-skills-bootstrap/skills/bootstrap-multi-session/variants/claude-code.md
    includedBy: multi-session
    scopes: [{{ .user | quote }}, 멀티 세션, "peer CLI: Claude Code"]
  - key: multi-session@codex
    title: 멀티 세션 / Codex CLI peer
    file: plugins/project-skills-bootstrap/skills/bootstrap-multi-session/variants/codex.md
    includedBy: multi-session
    scopes: [{{ .user | quote }}, 멀티 세션, "peer CLI: Codex CLI"]
  - key: multi-session@copilot
    title: 멀티 세션 / GitHub Copilot CLI peer
    file: plugins/project-skills-bootstrap/skills/bootstrap-multi-session/variants/copilot.md
    includedBy: multi-session
    scopes: [{{ .user | quote }}, 멀티 세션, "peer CLI: GitHub Copilot CLI"]
  - key: multi-session@gemini
    title: 멀티 세션 / Gemini CLI peer
    file: plugins/project-skills-bootstrap/skills/bootstrap-multi-session/variants/gemini.md
    includedBy: multi-session
    scopes: [{{ .user | quote }}, 멀티 세션, "peer CLI: Gemini CLI"]
