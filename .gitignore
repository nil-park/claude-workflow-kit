# scratch dir for gh --body-file payloads
/.refs/

# spec doc originals fetched per docs/setup/
/.spec-docs/

# credentials such as the GCP service account key
/.secrets/

# durable local datasets for re-running migrations (e.g. neo4j-memory)
/.data/

# personal Claude Code settings
/.claude/settings.local.json

# crash dumps a dying Git Bash leaves behind
*.stackdump

# python dev tooling
/.venv/
__pycache__/
/.pytest_cache/
/.ruff_cache/

# go build outputs (make statusline)
/build/
